#!/usr/bin/env bash
# Version bump — only fires when you signal it in the commit message.
#
#  [feature] / [feat]  → minor bump (4.1 → 4.2)
#  [major]             → major bump (4.x → 5.0)
#  (nothing)           → commit proceeds, version unchanged

set -e

REPO_ROOT="$(git rev-parse --show-toplevel)"
VERSION_FILE="$REPO_ROOT/version.json"
CHANGELOG_FILE="$REPO_ROOT/CHANGELOG.md"

MSG_FILE="$REPO_ROOT/.git/COMMIT_EDITMSG"
COMMIT_MSG=""
[ -f "$MSG_FILE" ] && COMMIT_MSG=$(cat "$MSG_FILE")

HAS_MAJOR=$(echo "$COMMIT_MSG"   | grep -c '\[major\]'             || true)
HAS_FEATURE=$(echo "$COMMIT_MSG" | grep -cE '\[feature\]|\[feat\]' || true)

[ "$HAS_MAJOR" -eq 0 ] && [ "$HAS_FEATURE" -eq 0 ] && exit 0

[ -f "$VERSION_FILE" ] || echo '{"version":"4.0","date":"","label":""}' > "$VERSION_FILE"

CURRENT=$(node -p "require('$VERSION_FILE').version")
MAJOR=$(echo "$CURRENT" | cut -d. -f1)
MINOR=$(echo "$CURRENT" | cut -d. -f2)

if [ "$HAS_MAJOR" -gt 0 ]; then
  NEW_VERSION="$((MAJOR + 1)).0"; BUMP_TYPE="MAJOR"
else
  NEW_VERSION="${MAJOR}.$((MINOR + 1))"; BUMP_TYPE="minor"
fi

TODAY=$(date +%Y-%m-%d)

# Strip tags and tidy
CLEAN_MSG=$(echo "$COMMIT_MSG" | sed 's/\[major\]//g; s/\[feature\]//g; s/\[feat\]//g' | sed 's/^[[:space:]]*//; s/[[:space:]]*$//')
TITLE=$(echo "$CLEAN_MSG" | head -1 | sed 's/^[a-z]*: *//')
BODY=$(echo "$CLEAN_MSG" | tail -n +3)

# Update version.json using a temp file (avoids any quoting issues)
SAFE_TITLE=$(echo "$TITLE" | head -c 80 | sed "s/'/\\\\'/g")
node - "$VERSION_FILE" "$NEW_VERSION" "$TODAY" "$SAFE_TITLE" << 'JS'
const fs = require('fs');
const [,, file, ver, date, label] = process.argv;
const v = JSON.parse(fs.readFileSync(file, 'utf8'));
v.version = ver; v.date = date; v.label = label;
fs.writeFileSync(file, JSON.stringify(v, null, 2) + '\n');
JS

# Build changelog entry
if [ -n "$BODY" ]; then
  ENTRY="## v${NEW_VERSION} — ${TODAY} (${BUMP_TYPE} bump)\n\n**${TITLE}**\n\n${BODY}\n\n---"
else
  ENTRY="## v${NEW_VERSION} — ${TODAY} (${BUMP_TYPE} bump)\n\n**${TITLE}**\n\n---"
fi

HEADER=$(head -5 "$CHANGELOG_FILE" 2>/dev/null || echo "# Changelog")
REST=$(tail -n +6 "$CHANGELOG_FILE" 2>/dev/null || echo "")

printf '%s\n\n%b\n\n%s\n' "$HEADER" "$ENTRY" "$REST" > "$CHANGELOG_FILE"

git add "$VERSION_FILE" "$CHANGELOG_FILE"
echo "🔖 Version bumped ${CURRENT} → ${NEW_VERSION} (${BUMP_TYPE})"
